extends RefCounted
class_name PlanetState
## Live state of a single planetary body inside one star system.
##
## Pure data plus the derived queries the turn resolver needs. Deliberately free of any
## engine node references so the whole galaxy can be serialised to JSON for saves and
## replicated over the wire.

## Index into `GalaxyState.systems`.
var index: int = -1

## `PlanetTypeData.id` this body was generated as.
var type_id: StringName = &"terrestrial"

## Display name, e.g. "Verdania". Empty means "use the catalogue designation", which is
## what an old save or a hand-built test body gets.
var name: String = ""

## Orbital ring within the system, purely for display ordering. Bodies used to be capped at
## six per system; there is one system now, so this is the ring index for any planet count.
var orbit: int = 0

## Owning faction, or -1 when unclaimed.
var owner: int = -1

## Colonised flag. An owned but uncolonised body is a captured outpost.
var colonized: bool = false

## Population in millions.
var population: float = 0.0

## Structure counts keyed by `BuildingData.id`.
var structures: Dictionary = {}

## Local stockpile.
var reserve_metals: float = 0.0
var reserve_rare: float = 0.0
var reserve_energy: float = 0.0

## Cumulative terraforming progress, 0..1.
var terraform_progress: float = 0.0

## Structures currently under construction keyed by `BuildingData.id`.
var building_queue: Dictionary = {}

## Turns remaining on the construction in `building_queue`.
var build_turns_remaining: int = 0

## Production points banked toward the next ship in the yard.
var shipyard_progress: float = 0.0
## Hulls queued for construction, oldest first. Stored untyped because it round-trips
## through JSON, which does not preserve element types; `_coerce_ship_queue` re-types it.
var ship_queue: Array = []

## Food banked for the colony, in units. A surplus carries over; a deficit runs it down.
var food_stock: float = 0.0

## Military troops stationed here. Raised by Barracks at the cost of one civilian pop each.
##
## Troops neither eat nor research: `ColonySim` excludes them from `food_consumed`, and
## `ResearchStage` counts only `population` toward the research budget. They exist purely to
## hold a garrison and to be landed by an invader.
var troops: int = 0

## Power banked on this world, in units. Regenerated by power stations every turn and
## drained by structures that require it. Overflow is silent -- unlike food, exceeding the
## power storage cap raises no warning and simply loses the surplus.
var power: float = 0.0

## Storage capacity and power budget, recomputed by `ColonySim` from the structure table
## every turn and cached here so the UI and the build-order guards can read them without
## carrying a `Defs` reference. Never authored: they are derived.
var food_capacity: float = 0.0
var power_capacity: float = 0.0
var power_generated: float = 0.0
var power_drawn: float = 0.0
var housing: float = 0.0

## Standing warnings, as `StringName` keys. Raised by the colony sim and cleared each turn,
## so a warning is always a statement about the turn that just resolved. The food-overflow
## warning is deliberately *not* raised in the turn the overflow happened but the one after,
## which is what the design document asks for.
##
## Untyped because it round-trips through JSON, which does not preserve element types.
var warnings: Array = []

## `Enums.BuildMode`. `SINGLE` builds exactly one structure per turn; `PER_TURN` allows one
## or more ships per turn, gated on the colony producing at least the hull's full metal cost
## every turn.
var build_mode: int = 0

## Metal banked toward whatever is currently under construction.
##
## The construction progress bar in the construction panel is clickable: pressing it opens the
## boost modal, and the metal the player transfers is debited from `reserve_metals` and added
## here. Production adds to this pool too, at the project's metal cost spread evenly over its
## build turns, so turn N of a T-turn project reads as N/T on the bar whatever the structure
## costs.
##
## This is an *accounting* pool, not a store. Metal arrives here either because production
## earned it or because the player explicitly moved it, and in both cases it has already been
## debited from `reserve_metals` at the moment it was credited. It is never returned.
var build_metal: float = 0.0

## Total build turns the current project was started with.
##
## Needed because `build_turns_remaining` counts *down*: dividing the cost by what remains
## would give each remaining turn an equal share of the whole cost and finish the project in
## about half the turns. Capturing the original figure at queue time is what makes the
## per-turn contribution `cost / total_turns` and the bar read N/T.
var build_total_turns: int = 0

## Whether the owner has surveyed this body (drives fog of war).
var surveyed: bool = false

## Cached `PlanetTypeData`, refreshed by the generator; never serialised.
var _type: Resource = null


func bind_type(type_data: Resource) -> void:
	_type = type_data


func type_data() -> Resource:
	return _type


## Roll the uncolonised reserves this body starts with. Called by the generator.
func seed_reserves(type_data: Resource) -> void:
	reserve_metals = type_data.get("base_reserve_metals")
	reserve_rare = type_data.get("base_reserve_rare")
	reserve_energy = type_data.get("base_reserve_energy")


## Habitability after terraforming. Falls back to the cached type.
func habitability() -> float:
	if _type == null:
		return 0.0
	return _type.call("effective_habitability", terraform_progress)


## Maximum sustainable population, millions. Zero when uninhabitable.
func max_population() -> float:
	var hab := habitability()
	if hab <= 0.0:
		return 0.0
	return hab * 20.0


## Standing warnings, typed. See `warnings` for why the list itself is untyped.
func warning_set() -> Dictionary:
	var out := {}
	for key: Variant in warnings:
		out[StringName(str(key))] = true
	return out


## Whether this world is currently short of the power its structures draw.
##
## The distinction that matters for Phase 8: running out of power is *not* a penalty. Every
## structure already standing keeps working; what stops is building anything new that needs
## power, which is what `SessionController.queue_build_structure` and `TurnResolver`'s
## structure order check before accepting one.
func is_power_short() -> bool:
	return power < power_drawn


## Whether the colony can currently afford to start something that draws `amount` power.
##
## A colony already short cannot start a new power-drawing structure even if it has metal
## for it. This is the single rule that implements "running out of power only blocks new
## structures", and both the client and the resolver consult it so a button that looks
## affordable and an order the resolver silently drops cannot disagree.
func can_supply_power(amount: float) -> bool:
	return power + power_generated - power_drawn >= amount


## Total structures of a kind.
func count(kind_id: StringName) -> int:
	return int(structures.get(kind_id, 0))


## Structures of a `BuildingData.Kind`.
func count_by_kind(kind: int, registry: Dictionary) -> int:
	var total := 0
	for key: StringName in structures:
		var def: Resource = registry.get(key, null) as Resource
		if def != null and int(def.get("kind")) == kind:
			total += int(structures[key])
	return total


## True when this body is a valid settlement target for a faction.
func is_colonizable() -> bool:
	if _type == null:
		return false
	if not _type.get("colonizable"):
		return false
	return max_population() > 0.0


## Where this body sits on the map, in system-space units.
##
## New in the single-system model: planets used to be drawn only as rows in a list and
## took their position from the system they orbited. They are the primary map objects now,
## so each one carries its own coordinate — laid out by the generator along a concentric
## orbit ring and rendered as a clickable marker.
var position: Vector2 = Vector2.ZERO


## Serialise to a plain dictionary for saves and network replication.
func to_dict() -> Dictionary:
	return {
		"index": index,
		"type_id": String(type_id),
		"name": name,
		"orbit": orbit,
		"position": [position.x, position.y],
		"owner": owner,
		"colonized": colonized,
		"population": population,
		"structures": structures.duplicate(true),
		"reserve_metals": reserve_metals,
		"reserve_rare": reserve_rare,
		"reserve_energy": reserve_energy,
		"terraform_progress": terraform_progress,
		"building_queue": building_queue.duplicate(true),
		"build_turns_remaining": build_turns_remaining,
		"shipyard_progress": shipyard_progress,
		"ship_queue": ship_queue.duplicate(true),
		"food_stock": food_stock,
		"troops": troops,
		"power": power,
		"build_mode": build_mode,
		"build_metal": build_metal,
		"build_total_turns": build_total_turns,
		"warnings": warnings.duplicate(true),
		"surveyed": surveyed,
	}


## Restore from `to_dict()` output. Returns false when required fields are missing.
func from_dict(data: Dictionary) -> bool:
	if not data.has("index") or not data.has("type_id"):
		push_error("[PlanetState] dictionary missing required fields")
		return false
	index = int(data["index"])
	type_id = StringName(str(data["type_id"]))
	name = str(data.get("name", ""))
	orbit = int(data.get("orbit", 0))
	# Absent in saves written before planets became map objects. Those bodies load at the
	# origin rather than failing: a galaxy is still playable, every planet is simply drawn
	# on top of the star until the next generation.
	var pos: Array = data.get("position", []) as Array
	if pos.size() == 2:
		position = Vector2(float(pos[0]), float(pos[1]))
	owner = int(data.get("owner", -1))
	colonized = bool(data.get("colonized", false))
	population = float(data.get("population", 0.0))
	structures = data.get("structures", {}).duplicate(true)
	reserve_metals = float(data.get("reserve_metals", 0.0))
	reserve_rare = float(data.get("reserve_rare", 0.0))
	reserve_energy = float(data.get("reserve_energy", 0.0))
	terraform_progress = float(data.get("terraform_progress", 0.0))
	building_queue = data.get("building_queue", {}).duplicate(true)
	build_turns_remaining = int(data.get("build_turns_remaining", 0))
	shipyard_progress = float(data.get("shipyard_progress", 0.0))
	ship_queue = _coerce_ship_queue(data.get("ship_queue", []))
	food_stock = float(data.get("food_stock", 0.0))
	# Absent from every save written before Phase 8, so each defaults rather than failing:
	# a pre-Phase-8 colony loads as a world with no troops, no banked power and the old
	# single-project construction rule.
	troops = int(data.get("troops", 0))
	power = float(data.get("power", 0.0))
	build_mode = int(data.get("build_mode", 0))
	build_metal = float(data.get("build_metal", 0.0))
	build_total_turns = int(data.get("build_total_turns", 0))
	warnings = _coerce_warnings(data.get("warnings", []))
	surveyed = bool(data.get("surveyed", false))
	return true


## JSON round-trips drop element types, so re-type the warning list and drop anything that is
## not a string. A malformed entry is discarded rather than poisoning the warning readout.
static func _coerce_warnings(raw: Array) -> Array:
	var out: Array = []
	for entry: Variant in raw:
		var key := StringName(str(entry))
		if key != &"":
			out.append(key)
	return out


## JSON round-trips drop element types, so re-type the queue and drop anything that is
## not a dictionary. A malformed entry is discarded rather than poisoning the build queue.
static func _coerce_ship_queue(raw: Array) -> Array:
	var out: Array = []
	for entry: Variant in raw:
		if entry is Dictionary:
			out.append((entry as Dictionary).duplicate(true))
	return out


## Ordering-independent fingerprint, used by determinism tests.
##
## Keys are sorted and stringified before formatting: Godot preserves dictionary
## insertion order and renders `StringName` keys with an `&` prefix, so a JSON round-trip
## (which retypes every key to `String`) would otherwise hash an identical planet
## differently from the in-memory original.
func fingerprint() -> String:
	# `position` is part of the hash: planets are placed on distinct orbit rings, and two
	# layouts that differ only in where a body sits are different games. Leaving it out
	# would let a regression reorder the whole system without a single determinism test
	# noticing.
	return "%d:%s:%s:%d:%.3f,%.3f:%d:%s:%.4f:%s:%.2f:%.2f:%.2f:%.4f:%s:%.4f:%.4f:%d:%d:%.4f:%d:%.2f:%d:%s" % [
		index, String(type_id), name, orbit, position.x, position.y,
		owner, str(colonized), population,
		_sorted_keys(structures), reserve_metals, reserve_rare, reserve_energy,
		terraform_progress, _sorted_keys(building_queue), shipyard_progress,
		food_stock, build_turns_remaining, troops, power, build_mode, build_metal,
		build_total_turns,
		_sorted_keys(warning_set()),
	]


## Sorted, plain-String rendering of a dictionary's keys. See `KeyText.sorted_keys`.
static func _sorted_keys(source: Dictionary) -> String:
	return KeyText.sorted_keys(source)